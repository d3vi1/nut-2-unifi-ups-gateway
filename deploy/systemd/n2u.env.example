# Native daemon on a Linux appliance whose sole Network identity is the UPS.
# Use a separate, private environment file; do not reuse Compose's .env here.
N2U_NETWORK_MODE=shared
# Replace this documentation-only address with the host's actual LAN IPv4.
N2U_DEVICE_IP=192.0.2.20
# MAC is read from the interface that owns that IP; no invented identity.
N2U_INFORM_URL=http://192.0.2.10:8080/inform
N2U_NUT_ADDRESS=127.0.0.1:3493
N2U_NUT_UPS=ups
N2U_NUT_ALLOW_INSECURE_REMOTE=false
N2U_STATE_FILE=/var/lib/n2u/state.json
N2U_HEALTH_ADDRESS=127.0.0.1:9199
# Keep compatibility options off unless you accept their documented limits.
N2U_UNIFI_HTTP_GCM_CONFIG_RECEIPT_MODE=off
N2U_UNIFI_HTTP_GCM_REPORTED_FIRMWARE_SYNC=false
