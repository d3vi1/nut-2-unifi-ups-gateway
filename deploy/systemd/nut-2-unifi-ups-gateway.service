[Unit]
Description=Read-only NUT to UniFi UPS gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=n2u
StateDirectoryMode=0700
EnvironmentFile=/etc/n2u/gateway.env
ExecStart=/usr/local/bin/nut-2-unifi-ups-gateway
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
# net.Interfaces uses read-only netlink; DNS can also use local UNIX sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
